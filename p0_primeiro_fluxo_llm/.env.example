# Configuração do P0 para o Devel institucional.
# A aplicação usa a porta local do encaminhamento SSH.
LLM_API_URL=https://127.0.0.1:19001/api/generate

# Preencha com o nome do host informado pelo Devel, sem protocolo ou porta.
HOST_API_LLM_INTERNO=

# Configurações do modelo
LLM_MODEL=qwen3.5:9b-q4_K_M
LLM_TIMEOUT_SECONDS=120
LLM_VERIFICAR_TLS=false
LLM_THINK=false

# Login opcional do portal Devel. Preencha apenas no .env local.
DEVEL_EMAIL=
DEVEL_SENHA=